[Unit]
Description=Detector de huevos con daños (FastAPI + LiteRT: YOLOv8n + U-Net de zona dañada)
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/eggs-detector/app/server
# Para volver a la versión anterior: EGGS_DET_FILE=eggs_v4_fp32.tflite, EGGS_SEG_FILE=eggs_dano_v1_fp16.tflite,
# quitar EGGS_SEG_FALLBACK y EGGS_CRACK_RATIO, y volver a ejecutar install.sh.
Environment=EGGS_DET_FILE=eggs_v5_fp32.tflite
Environment=EGGS_SEG_FILE=eggs_dano_v2_fp16.tflite
Environment=EGGS_SEG_FALLBACK=eggs_dano_v1_fp16.tflite
Environment=EGGS_CRACK_RATIO=0.3
Environment=EGGS_SAMPLES_DIR=/home/ubuntu/eggs-data/test
Environment=EGGS_EVAL_JSON=/home/ubuntu/eggs-data/eval_test.json
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/eggs-detector/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000 --workers 1 --no-access-log --timeout-keep-alive 30
Restart=always
RestartSec=3
# la instancia tiene poca RAM y comparte con otros servicios
MemoryHigh=450M
MemoryMax=600M

[Install]
WantedBy=multi-user.target
